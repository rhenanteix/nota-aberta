{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'static site'",
  "installCommand": "echo 'no install'",
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/conta/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/entrar/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/sair",
      "destination": "/api/index.py"
    },
    {
      "source": "/mcp",
      "destination": "/api/index.py"
    }
  ]
}
