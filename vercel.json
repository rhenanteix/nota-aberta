{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'static site'",
  "installCommand": "echo 'no install'",
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nota-aberta.vercel.app/api/:path*"
    },
    {
      "source": "/conta/:path*",
      "destination": "https://nota-aberta.vercel.app/conta/:path*"
    },
    {
      "source": "/entrar/:path*",
      "destination": "https://nota-aberta.vercel.app/entrar/:path*"
    },
    {
      "source": "/sair",
      "destination": "https://nota-aberta.vercel.app/sair"
    },
    {
      "source": "/mcp",
      "destination": "https://nota-aberta.vercel.app/mcp"
    }
  ]
}